# Copy to .env and fill in. .env is gitignored — never commit real values.
# In production these are set in Vercel → Settings → Environment Variables.

# From @BotFather. Treat as a password: it grants full control of the bot.
TELEGRAM_BOT_TOKEN=

# Public, not a secret — used to build the t.me/<username>?start=<token> link.
VITE_TELEGRAM_BOT_USERNAME=Halimov_kursi_bot

# Random string you invent. Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header so the webhook can reject forged calls.
# It also signs the link tokens, so changing it invalidates every unused link.
TELEGRAM_WEBHOOK_SECRET=

# Supabase → Settings → API. The service_role key bypasses RLS and must never
# be given a VITE_ prefix — Vite inlines those straight into the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Unlocks the teacher's Telegram page: minting parent links, seeing who is
# linked, unlinking, and sending attendance/payment messages. NOT the site
# login password — this one never reaches the browser, which is the whole
# point. Minimum 12 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TEACHER_PANEL_PASSWORD=
